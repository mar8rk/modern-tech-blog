---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="Learn about the author and the motivation behind this technology blog" />
	</head>
	<body class="bg-white">
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-8">
			<article>
				<!-- Header -->
				<header class="text-center py-12">
					<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
						About This Blog
					</h1>
					<p class="text-xl text-gray-600 max-w-2xl mx-auto">
						Professional insights on technology with full content ownership and control.
					</p>
				</header>

				<!-- Content -->
				<div class="prose prose-lg max-w-none">
					<section class="mb-12">
						<h2 class="text-3xl font-bold text-gray-900 mb-6">Why This Blog Exists</h2>
						<p class="text-lg text-gray-600 mb-6">
							This blog was created to share professional thoughts on technology with a tech audience
							(colleagues, developers, industry peers) while maintaining complete content ownership and control.
							Rather than depending on third-party platforms, this site ensures that insights and professional
							content remain accessible and under full control.
						</p>

						<div class="grid md:grid-cols-2 gap-8 my-8">
							<div class="bg-gray-50 p-6 rounded-lg">
								<h3 class="text-xl font-semibold text-gray-900 mb-3">Content Ownership</h3>
								<p class="text-gray-600">
									Full control over content, platform policies, and long-term availability.
									No risk of losing published insights to platform changes or restrictions.
								</p>
							</div>
							<div class="bg-gray-50 p-6 rounded-lg">
								<h3 class="text-xl font-semibold text-gray-900 mb-3">Professional Platform</h3>
								<p class="text-gray-600">
									A discoverable platform for sharing professional tech insights that
									colleagues and industry peers can reference and link to.
								</p>
							</div>
						</div>
					</section>

					<section class="mb-12">
						<h2 class="text-3xl font-bold text-gray-900 mb-6">Technical Approach</h2>
						<p class="mb-6">
							This blog follows a "simple and straightforward" design philosophy, inspired by clean,
							professional sites like anildash.com and hidekazu-konishi.com. The technical implementation
							prioritizes performance and simplicity:
						</p>

						<ul class="space-y-3 mb-6">
							<li class="flex items-start">
								<span class="text-blue-600 mr-2">•</span>
								<span><strong>Static Site Generation</strong> - Built with Astro for sub-second load times</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-600 mr-2">•</span>
								<span><strong>Global CDN</strong> - Delivered via AWS CloudFront for worldwide performance</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-600 mr-2">•</span>
								<span><strong>Git-based Workflow</strong> - Content managed through version control</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-600 mr-2">•</span>
								<span><strong>Minimal Infrastructure</strong> - ~$3-8/month operating costs</span>
							</li>
						</ul>
					</section>

					<section class="mb-12">
						<h2 class="text-3xl font-bold text-gray-900 mb-6">What to Expect</h2>
						<p class="mb-6">
							This blog focuses on sharing valuable tech insights and professional thoughts with
							an audience that includes:
						</p>

						<div class="bg-blue-50 p-6 rounded-lg mb-6">
							<ul class="space-y-2">
								<li><strong>Colleagues and Team Members</strong> - Sharing knowledge and learnings</li>
								<li><strong>Fellow Developers</strong> - Technical insights and problem-solving approaches</li>
								<li><strong>Industry Peers</strong> - Professional perspectives on technology trends</li>
								<li><strong>Potential Employers</strong> - Demonstrating technical expertise and thought leadership</li>
							</ul>
						</div>

						<p>
							The goal is to create content valuable enough that people will link to it and find it
							through search engines when looking for relevant tech topics.
						</p>
					</section>

					<section class="bg-gray-50 -mx-4 px-4 py-8 rounded-lg">
						<h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Get in Touch</h2>
						<p class="text-center text-gray-600 mb-6">
							Interested in discussing technology, collaboration, or have questions about the content?
						</p>
						<div class="flex justify-center space-x-4">
							<a
								href="/blog"
								class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors"
							>
								Read the Blog
							</a>
							<a
								href="/"
								class="border border-gray-300 hover:border-gray-400 text-gray-700 px-6 py-3 rounded-lg font-medium transition-colors"
							>
								Back to Home
							</a>
						</div>
					</section>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
